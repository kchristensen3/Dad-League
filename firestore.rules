rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidMember(data) {
      return data.keys().hasAll(['userId', 'displayName', 'email']) &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 200;
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['title', 'suggestedBy', 'votes', 'leagueId', 'category']) &&
             data.title is string && data.title.size() <= 200 &&
             data.suggestedBy is string &&
             data.leagueId is string &&
             (data.votes is list) &&
             data.category is string;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['date', 'activityName', 'hostId', 'hostName', 'attendees', 'declined', 'status', 'leagueId']) &&
             data.activityName is string && data.activityName.size() <= 200 &&
             data.hostId is string && data.hostName is string &&
             data.leagueId is string &&
             data.date is string &&
             data.attendees is list && data.declined is list &&
             data.status in ['planned', 'completed', 'cancelled'];
    }

    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'title', 'content', 'createdAt', 'leagueId']) &&
             data.authorId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.leagueId is string &&
             data.content is string && data.content.size() <= 10000 &&
             (!('imageUrl' in data) || data.imageUrl is string) &&
             (!('linkPreview' in data) || data.linkPreview == null || (data.linkPreview is map && data.linkPreview.url is string));
    }

    function isValidComment(data) {
      return data.keys().hasAll(['authorId', 'postId', 'text', 'createdAt', 'leagueId']) &&
             data.authorId == request.auth.uid &&
             data.postId is string &&
             data.leagueId is string &&
             data.text is string && data.text.size() <= 2000;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'text', 'createdAt', 'leagueId']) &&
             (data.senderId == request.auth.uid || data.senderId == 'SYSTEM') &&
             data.leagueId is string &&
             data.text is string && data.text.size() <= 10000;
    }

    // Health / Connection check
    match /test/{docId} {
      allow read: if true;
    }

    match /leagues/{leagueId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(leagueId);
      allow update: if isSignedIn() && (
        // Joining with invite code
        (incoming().diff(existing()).affectedKeys().hasOnly(['memberIds']) && 
         request.auth.uid in incoming().memberIds) ||
        // Owner management
        (isOwner(existing().ownerId))
      );
    }

    match /members/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && isValidMember(incoming());
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(activityId) && isValidActivity(incoming());
      allow update: if isSignedIn() && (
        // Voting toggle
        (incoming().diff(existing()).affectedKeys().hasOnly(['votes'])) ||
        // Owner edit
        (isOwner(existing().suggestedBy))
      );
      allow delete: if isSignedIn() && isOwner(existing().suggestedBy);
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(sessionId) && isValidSession(incoming());
      allow update: if isSignedIn() && (
        // RSVP toggle
        (incoming().diff(existing()).affectedKeys().hasOnly(['attendees', 'declined'])) ||
        // Host edit
        (isOwner(existing().hostId))
      );
      allow delete: if isSignedIn() && isOwner(existing().hostId);
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(postId) && isValidPost(incoming());
      allow update: if isSignedIn() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes'])) ||
        (isOwner(existing().authorId))
      );
      allow delete: if isSignedIn() && isOwner(existing().authorId);

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(commentId) && isValidComment(incoming());
        allow delete: if isSignedIn() && isOwner(existing().authorId);
      }
    }

    match /messages/{messageId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming());
    }
  }
}

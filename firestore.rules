rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isLeagueMember(leagueId) {
      return isSignedIn() && 
             leagueId is string &&
             (
               leagueId == 'default-league' ||
               (exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
                'leagueIds' in get(/databases/$(database)/documents/members/$(request.auth.uid)).data &&
                leagueId in get(/databases/$(database)/documents/members/$(request.auth.uid)).data.leagueIds) ||
               (exists(/databases/$(database)/documents/leagues/$(leagueId)) &&
                'memberIds' in get(/databases/$(database)/documents/leagues/$(leagueId)).data &&
                request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberIds)
             );
    }

    // Validation Blueprints
    function isValidMember(data) {
      return data.keys().hasAll(['userId', 'displayName', 'email']) &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             (!('notificationPreferences' in data) || data.notificationPreferences is map);
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['title', 'suggestedBy', 'votes', 'leagueId', 'category', 'status']) &&
             data.title is string && data.title.size() <= 200 &&
             data.suggestedBy is string &&
             data.leagueId is string &&
             (data.votes is list) &&
             data.category is string &&
             data.status in ['active', 'archived'];
    }

    function isValidSession(data) {
      return data.keys().hasAll(['date', 'activityName', 'hostId', 'hostName', 'attendees', 'declined', 'status', 'leagueId']) &&
             data.activityName is string && data.activityName.size() <= 200 &&
             data.hostId is string && data.hostName is string &&
             data.leagueId is string &&
             data.date is string &&
             data.attendees is list && data.declined is list &&
             data.status in ['planned', 'completed', 'cancelled'] &&
             (!('url' in data) || data.url == null || (data.url is string && data.url.size() <= 2048));
    }

    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'title', 'content', 'createdAt', 'leagueId']) &&
             data.authorId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.leagueId is string &&
             data.content is string && data.content.size() <= 10000 &&
             (!('imageUrl' in data) || data.imageUrl is string) &&
             (!('linkPreview' in data) || data.linkPreview == null || (data.linkPreview is map && data.linkPreview.url is string));
    }

    function isValidComment(data) {
      return data.keys().hasAll(['authorId', 'postId', 'text', 'createdAt', 'leagueId']) &&
             data.authorId == request.auth.uid &&
             data.postId is string &&
             data.leagueId is string &&
             data.text is string && data.text.size() <= 2000;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'text', 'createdAt', 'leagueId']) &&
             (data.senderId == request.auth.uid || data.senderId == 'SYSTEM') &&
             data.leagueId is string &&
             data.text is string && data.text.size() <= 10000;
    }

    // Helper for legacy data migration in rules
    function effectiveLeagueId(data) {
      return 'leagueId' in data ? data.leagueId : 'default-league';
    }

    match /leagues/{leagueId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isValidId(leagueId);
      allow update: if (
        incoming().diff(existing()).affectedKeys().hasOnly(['inviteTaps']) ||
        (isSignedIn() && (
          incoming().diff(existing()).affectedKeys().hasOnly(['memberIds']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'inviteJoins']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'inviteTaps']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['description']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['inviteCode']) ||
          (isOwner(existing().ownerId) && incoming().ownerId == existing().ownerId)
        ))
      );
      allow delete: if isSignedIn() && (isOwner(existing().ownerId) || true);
    }

    function memberLeagues() {
      let data = get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
      return 'leagueIds' in data ? data.leagueIds : ['default-league'];
    }

    function isInSameLeague(data) {
      let myLeagues = memberLeagues();
      let theirLeagues = 'leagueIds' in data ? data.leagueIds : ['default-league'];
      return myLeagues.hasAny(theirLeagues);
    }

    match /members/{userId} {
      allow get: if isSignedIn() && (
        userId == request.auth.uid ||
        // Check if we share a league
        (exists(/databases/$(database)/documents/members/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/members/$(request.auth.uid)).data.leagueIds.hasAny(existing().leagueIds)) ||
        true // Allow league mates lookup
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        (isOwner(userId) && (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'availability', 'location', 'interests', 'leagueIds', 'notificationPreferences', 'updatedAt']))) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['leagueIds'])
      );
      allow delete: if isSignedIn() && (isOwner(userId) || userId.matches('^dad_.*'));
    }

    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(activityId) && isValidActivity(incoming()) && incoming().suggestedBy == request.auth.uid;
      allow update: if isSignedIn() && (
        // Voting toggle & archive updates
        (incoming().diff(existing()).affectedKeys().hasOnly(['votes', 'lastUpvotedAt', 'status', 'archived', 'archivedAt'])) ||
        // Owner edit
        (isOwner(existing().suggestedBy) && isValidActivity(incoming()) && incoming().diff(existing()).affectedKeys().hasAny(['title', 'description', 'category', 'location', 'status', 'archived', 'lastUpvotedAt', 'updatedAt', 'archivedAt']))
      );
      allow delete: if isSignedIn() && isOwner(existing().suggestedBy);
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(sessionId) && isValidSession(incoming());
      allow update: if isSignedIn() && (
        // Action: RSVP
        (incoming().diff(existing()).affectedKeys().hasOnly(['attendees', 'declined'])) ||
        // Action: Host or Member Edit
        (incoming().diff(existing()).affectedKeys().hasAny(['date', 'activityName', 'activityType', 'location', 'description', 'status', 'updatedAt', 'url', 'hostId', 'hostName']))
      );
      allow delete: if isSignedIn() && (isOwner(existing().hostId) || isSignedIn());
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(postId) && isValidPost(incoming());
      allow update: if isSignedIn() && (
        // Like action
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes'])) ||
        // Author edit
        (isOwner(existing().authorId) && (incoming().diff(existing()).affectedKeys().hasAny(['content', 'imageUrl', 'linkPreview'])))
      );
      allow delete: if isSignedIn() && isOwner(existing().authorId);

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(commentId) && isValidComment(incoming());
        allow delete: if isSignedIn() && isOwner(existing().authorId);
      }
    }

    match /messages/{messageId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming());
    }

    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(pollId) && incoming().createdBy == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (isOwner(existing().createdBy) || isSignedIn());
    }

    match /availability/{availId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (incoming().userId == request.auth.uid);
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid);
    }
  }
}

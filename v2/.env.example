# Local development. Copy to .env. On Railway, set these as service variables.

# Railway: reference the Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dadleague

# Public URL of the app (used for the Google OAuth redirect). On Railway this
# defaults to https://$RAILWAY_PUBLIC_DOMAIN, so you only need it for a custom domain.
# APP_URL=https://dadleague.example.com

# Google sign-in. Authorized redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (needs a paid Apple Developer account). See README → "Setting up Sign in with Apple".
# APPLE_CLIENT_ID is the Services ID (e.g. com.yourname.dadleague.web), not the App ID.
# APPLE_PRIVATE_KEY is the full contents of the .p8 file (newlines or \n both work).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email-only sign-in for local dev and tests. Refused when NODE_ENV=production.
DEV_LOGIN=true

# Claude: idea suggestions and the Commissioner's weekly note (both off without it)
ANTHROPIC_API_KEY=

# Photo storage (optional locally, required for photos in production). Any S3-compatible
# bucket works, e.g. a Railway Storage Bucket. Without one, local dev saves to UPLOAD_DIR.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true   # set if your provider needs path-style URLs
# UPLOAD_DIR=uploads

# Background jobs (standing meetups, reminders, photo prompts, the Commissioner). On by default.
# SCHEDULER=false

# Web Push (optional). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["web/src/**/*", "shared/**/*.ts", "vite.config.ts", "vitest.config.ts", "drizzle.config.ts", "server/test/**/*.ts", "e2e/**/*.ts", "playwright.config.ts"]
}
